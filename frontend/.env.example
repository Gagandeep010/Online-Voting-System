# Frontend Environment Configuration
# Development Environment

# API Configuration
REACT_APP_BACKEND_URL=http://localhost:5000
REACT_APP_API_TIMEOUT=30000  # 30 seconds

# Facial Recognition Configuration
REACT_APP_FACE_API_MODEL_URL=/models/
REACT_APP_FACIAL_MIN_CONFIDENCE=0.8
REACT_APP_FACIAL_CAPTURE_COUNT=1

# Blockchain Configuration
REACT_APP_BLOCKCHAIN_NETWORK=http://127.0.0.1:8545
REACT_APP_CONTRACT_ADDRESS=0x44e99AF3127E4662beE4C2b1bA1d380F5510638f

# Application Configuration
REACT_APP_APP_NAME=Online Voting System
REACT_APP_APP_VERSION=1.0.0
REACT_APP_ENVIRONMENT=development

# Voting Configuration
REACT_APP_VOTING_ENABLED=true
REACT_APP_ELECTION_TITLE=General Election 2024

# Feature Flags
REACT_APP_ENABLE_BLOCKCHAIN_VERIFICATION=true
REACT_APP_ENABLE_FACIAL_RECOGNITION=true
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_DEBUG_MODE=false
